#!/bin/bash
# Mock pdfimages with controllable output via OCR_MOCK_PDF_IMAGE_COUNT env var
if [[ "$1" == "-list" ]]; then
    COUNT="${OCR_MOCK_PDF_IMAGE_COUNT:-1}"
    # Print header lines + COUNT data lines
    echo "page   num  type   width height color comp bpc  enc interp  object ID x-ppi y-ppi size ratio"
    echo "--------------------------------------------------------------------------------------------"
    for i in $(seq 1 "$COUNT"); do
        echo "   1     $i image    100   100  rgb     3   8  jpeg   no        5  0   150   150 1.5K   5%"
    done
fi
